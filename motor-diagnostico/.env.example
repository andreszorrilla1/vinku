# ============================================================
# Motor de Autodiagnóstico — VinkU (independiente de Campus Pass)
# Copia este archivo como .env.local para desarrollo local.
# En Vercel, agrega estas variables en Project Settings → Environment Variables.
# ============================================================

# --- Supabase (opcional en local) ---
# Si no se configuran, la app corre con datos de ejemplo (mock) en memoria,
# suficiente para recorrer el flujo completo sin backend.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Edge Function de extracción de CV ---
# La API de Claude NUNCA se llama desde el navegador. La llave vive solo en
# la Edge Function (supabase/functions/extraer-cv). Se configura del lado del
# servidor con `supabase secrets set ANTHROPIC_API_KEY=...`, no aquí.
# Si la función no está desplegada, la app usa un extractor mock local.
VITE_EXTRAER_CV_URL=

VITE_APP_URL=http://localhost:5174
