# Sabaneta Cuenta — variables de entorno
# Copia este archivo a .env.local y llénalo. Nunca subas .env.local al repositorio.
# Regla: lo que lleva NEXT_PUBLIC_ lo puede ver cualquiera en el navegador. Ningún secreto va con ese prefijo.

# --- Supabase (Project Settings > API). En local: salida de `npm run db:iniciar` ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRETO. Solo servidor. Salta RLS: usar solo en tareas del sistema (cron, importaciones).
SUPABASE_SERVICE_ROLE_KEY=

# --- IA (Anthropic). SECRETO, solo servidor ---
ANTHROPIC_API_KEY=
CLAUDE_MODELO_RAPIDO=claude-haiku-5-5
CLAUDE_MODELO_SINTESIS=claude-sonnet-5-5
# Al superar este número de llamadas en el día, todo pasa a revisión manual.
IA_TOPE_DIARIO_LLAMADAS=2000

# --- Voz a texto (respaldo del dictado del navegador). Proveedor por elegir ---
VOZ_A_TEXTO_PROVEEDOR=
VOZ_A_TEXTO_API_KEY=

# --- Twilio Verify (WhatsApp + SMS). Se configuran en Supabase > Auth > Phone; aquí solo como referencia ---
TWILIO_ACCOUNT_SID=
TWILIO_VERIFY_SERVICE_SID=

# --- Secretos internos (generar con: openssl rand -hex 32) ---
# Protege las rutas /api/cron/* que llama Vercel Cron.
CRON_SECRET=
# Firma los QR rotativos de las Mesas de cuentas claras.
MESA_QR_SECRET=

# --- Sitio ---
# Dirección pública, sin barra final. Ej: https://sabanetacuenta.co
NEXT_PUBLIC_SITIO_URL=http://localhost:3000
# Correo o canal para reclamos sobre datos personales (Ley 1581).
NEXT_PUBLIC_CONTACTO_DATOS=

# --- Errores (opcional) ---
SENTRY_DSN=

# --- Privacidad ---
# Secreto para guardar un hash de la IP en los consentimientos (detectar abusos sin guardar la IP).
# Si se deja vacío, no se guarda nada de la IP.
IP_HASH_SECRETO=
