{
  "name": "sabaneta-cuenta",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "tipos": "next typegen && tsc --noEmit && tsc --noEmit -p tsconfig.sw.json",
    "formato": "prettier --write .",
    "formato:revisar": "prettier --check .",
    "prueba": "vitest run",
    "prueba:vigilar": "vitest",
    "e2e": "playwright test",
    "iconos": "tsx scripts/generar-iconos.mts",
    "db:iniciar": "supabase start",
    "db:detener": "supabase stop",
    "db:reiniciar": "supabase db reset",
    "db:tipos": "supabase gen types typescript --local > src/lib/supabase/tipos.ts",
    "revisar": "npm run lint && npm run tipos && npm run formato:revisar && npm run prueba"
  },
  "dependencies": {
    "@serwist/turbopack": "^9.5.13",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "lucide-react": "^1.61.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "serwist": "^9.5.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.5",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.5",
    "supabase": "^2.121.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
